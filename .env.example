# Copy to .env.local. Every key is optional: without it the route falls back to cached demo data.
OPENAI_API_KEY=
OPENAI_MODEL_VISION=        # optional; default gpt-6-luna (quotation photos)
OPENAI_MODEL_FAST=          # optional; default gpt-4.1-nano (replies, search, reviews)
OPENAI_MODEL_WRITE=         # optional; default gpt-6-luna (RFQ email, memo)
DEMO_MODE=0                # 1 = never call external APIs (cached data only)

TAVILY_API_KEY=            # web search for market prices, reviews, suppliers

GMAIL_USER=                # team test Gmail account (sends RFQs + bank email, inbox is polled for replies)
GMAIL_APP_PASSWORD=        # Gmail app password (IMAP + SMTP)
TEST_INBOX=                # where emails to non-allowed addresses get redirected
ALLOWED_RECIPIENTS=        # comma-separated team test inboxes allowed to receive mail
BANK_INBOX=                # test inbox acting as the bank's SME desk
COMPANY_NAME=Hamza Garments

MONGODB_URI=mongodb://127.0.0.1:27017   # Atlas connection string in production
MONGODB_DB=faisla
